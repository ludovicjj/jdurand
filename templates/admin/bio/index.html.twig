{% extends 'admin/admin_layout.html.twig' %}

{% block title %}Bio - {{ parent() }}{% endblock %}

{% block page_title %}Bio{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_bio') }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_bio') }}
{% endblock %}

{% block content %}
    <div class="w-full">
        {{ form_start(form) }}
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700 mb-6">
            <div class="space-y-6">
                <div>
                    {{ form_label(form.contentFr, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.contentFr, {'attr': {'class': 'w-full px-4 py-3 bg-slate-800 border border-slate-600 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition resize-none'}}) }}
                    {{ form_errors(form.contentFr, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
                </div>

                <div>
                    {{ form_label(form.contentEn, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.contentEn, {'attr': {'class': 'w-full px-4 py-3 bg-slate-800 border border-slate-600 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition resize-none'}}) }}
                    {{ form_errors(form.contentEn, {'attr': {'class': 'text-red-400 text-xs mt-1'}}) }}
                    <p class="text-slate-500 text-xs mt-2">Si vide, la version française sera affichée aux visiteurs anglophones.</p>
                </div>
            </div>

            <div class="flex items-center justify-end pt-6">
                <button type="submit"
                        class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg transition">
                    Enregistrer
                </button>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
