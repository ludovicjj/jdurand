{% for child in children %}
    <div class="ml-6 bg-slate-900 border border-slate-700 rounded-lg p-4 mb-1 hover:bg-[#16203a] transition">
        <div class="flex items-center gap-4">
            <div class="min-w-0 flex-1">
                <div class="text-white text-sm truncate">↳ {{ child.label }}</div>
                <div class="text-slate-500 text-xs truncate mt-0.5"><code>{{ child.slug }}</code></div>
            </div>
            <a href="{{ path('app_admin_page_update', {id: child.id}) }}"
               class="p-2 border border-slate-600 rounded-md text-slate-400 hover:text-white hover:border-slate-400
  transition shrink-0" title="Modifier">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2
  2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
            </a>
        </div>
        {% if child.children is not empty %}
            <div class="mt-2">
                {{ include('admin/page/_children.html.twig', {children: child.children}) }}
            </div>
        {% endif %}
    </div>
{% endfor %}