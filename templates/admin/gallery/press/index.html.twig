{% extends 'admin/admin_layout.html.twig' %}

{% block title %}Press - {{ parent() }}{% endblock %}

{% block page_title %}Press{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_gallery_index') }}
{% endblock %}

{% block content %}
    <div class="mb-6 flex justify-between items-center">
        <p class="text-slate-400">{{ galleryCount }} dossier(s) de presse</p>
        <a href="{{ path('app_admin_press_create', filterParams) }}"
           class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nouveau dossier de presse
        </a>
    </div>

    {% if galleries is empty %}
        <div class="bg-slate-900 rounded-xl p-12 border border-slate-700 text-center">
            <svg class="w-16 h-16 mx-auto text-slate-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <p class="text-slate-400 mb-4">Aucun dossier de presse pour le moment</p>
            <a href="{{ path('app_admin_press_create') }}"
               class="inline-flex items-center text-purple-400 hover:text-purple-300 transition">
                Créer votre premier dossier de presse
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        </div>
    {% else %}
        {% set sortable = true %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6"
             id="galleries-sortable"
             data-reorder-url="{{ path('app_admin_press_reorder') }}"
        >
            {% for item in galleries %}
                {% set gallery = item[0] %}
                {% set picturesCount = item.picturesCount %}
                {% set updateUrl = path('app_admin_press_update', {id: gallery.id}|merge(filterParams)) %}
                {% include 'admin/gallery/_partials/_gallery_card.html.twig' %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
