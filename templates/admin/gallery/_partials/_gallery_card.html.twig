<a href="{{ updateUrl }}"
   data-id="{{ gallery.id }}"
   class="relative block bg-slate-900 rounded-xl border border-slate-700 overflow-hidden hover:border-slate-600 transition"
>
    {% if sortable|default(false) %}
        <span class="drag-handle absolute top-1.5 right-1.5 z-10 p-1 rounded bg-slate-800/90 text-slate-400 hover:text-white cursor-grab active:cursor-grabbing"
              aria-label="Déplacer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>
            </svg>
        </span>
    {% endif %}
    <div class="flex items-stretch">
        <div class="shrink-0 w-24 h-24 bg-slate-800 relative">
            {% if gallery.thumbnail %}
                <img src="{{ s3_url(gallery.thumbnail.filename) }}" alt="{{ gallery.title }}" class="w-full h-full object-cover">
            {% else %}
                <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
            {% endif %}
        </div>
        <div class="flex-1 min-w-0 p-3 flex flex-col justify-between">
            <h3 class="text-sm font-semibold text-white truncate">{{ gallery.title }}</h3>
            <div class="flex items-center justify-between gap-2 text-xs text-slate-500">
                <span>{{ gallery.createdAt|date('d/m/Y') }}</span>
                <div class="inline-flex items-center gap-2">
                    {% if not gallery.visibility %}
                        <svg class="w-3 h-3 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-label="Privée">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    {% endif %}
                    <span class="inline-flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {{ picturesCount }}
                    </span>
                </div>
            </div>
        </div>
    </div>
</a>