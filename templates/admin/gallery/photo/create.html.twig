{% extends 'admin/admin_layout.html.twig' %}

{% block title %}Nouvelle galerie photo - {{ parent() }}{% endblock %}

{% block page_title %}Nouvelle galerie photo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_gallery') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_gallery') }}
{% endblock %}

{% block content %}
    <div class="w-full">
        {{ form_start(form) }}
        <div class="bg-slate-900 rounded-xl p-6 border border-slate-700 mb-6">
            {% include 'admin/gallery/_partials/_form_fields.html.twig' %}

            {# Form action #}
            <div class="flex items-center justify-between pt-6">
                <a href="{{ path('app_admin_gallery_index', filterParams) }}" class="text-purple-400 hover:text-purple-300 transition">
                    &larr; Retour aux photos
                </a>
                <button type="submit"
                        class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg transition">
                    Créer la galerie photo
                </button>
            </div>
        </div>

        {# Info : ajout des photos après création #}
        <div class="bg-slate-800/50 rounded-xl p-6 border border-slate-600 mb-6">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                    <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-medium text-white mb-2">Et les photos ?</h3>
                    <p class="text-slate-300">
                        Vous pourrez ajouter vos photos juste après avoir cliqué sur <strong class="text-purple-400">"Créer la galerie photo"</strong>.
                    </p>
                    <p class="text-slate-400 text-sm mt-2">
                        Commencez par remplir le titre et choisir une image de couverture ci-dessus.
                    </p>
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
