{# Masonry grid + empty state + infinite-scroll sentinel.
   Requires: galleries, activeCategory, hasMore, nextOffset, list_route, show_route #}
{% if galleries is empty %}
    <div class="text-center py-20">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="text-gray-500">
            {% if activeCategory %}
                {{ 'gallery.empty_in_category'|trans({'%category%': activeCategory.name}) }}
            {% else %}
                {{ 'gallery.empty'|trans }}
            {% endif %}
        </p>
    </div>
{% else %}
    <div id="gallery-grid"
         class="-mx-2"
         data-gallery-masonry
         data-api-url="{{ path(list_route) }}"
         data-category="{{ activeCategory ? activeCategory.slug : '' }}"
         data-next-offset="{{ nextOffset }}"
         data-has-more="{{ hasMore ? 'true' : 'false' }}"
         data-view-label="{{ 'gallery.view'|trans }}">
        <div class="masonry-sizer w-full sm:w-1/2 lg:w-1/3"></div>
        {% set showParams = activeCategory ? {category: activeCategory.slug} : {} %}
        {% for gallery in galleries %}
            <div class="masonry-item w-full sm:w-1/2 lg:w-1/3 px-2 mb-4">
                <a href="{{ path(show_route, {id: gallery.id, slug: gallery.slug ?: 'gallery'}|merge(showParams)) }}" class="group block">
                    <div class="overflow-hidden relative bg-gray-100">
                        {% if gallery.thumbnail %}
                            <img
                                    src="{{ s3_url(gallery.thumbnail.filename) }}"
                                    alt="{{ gallery.title }}"
                                    loading="lazy"
                                    class="w-full h-auto transition-transform duration-300 group-hover:scale-110"
                            >
                        {% else %}
                            <div class="aspect-square flex items-center justify-center">
                                <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                        {% endif %}

                        {# Mobile: dark overlay always visible, centered title + "Voir" CTA #}
                        <div class="md:hidden absolute inset-0 bg-black/40 flex flex-col items-center justify-center text-center px-4">
                            <h3 class="text-white text-base font-semibold">{{ gallery.title }}</h3>
                            <span class="mt-4 inline-block border border-white/70 text-white bg-white/10 font-medium text-sm px-6 py-2 rounded-lg transition-all">{{ 'gallery.view'|trans }}</span>
                        </div>

                        {# Desktop: title only on hover (no CTA needed, hover itself is the affordance) #}
                        <div class="hidden md:flex absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 items-center justify-center text-center px-4">
                            <h3 class="text-white text-xl font-semibold">{{ gallery.title }}</h3>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>

    {% if hasMore %}
        <div id="gallery-sentinel" class="flex justify-center py-8">
            <div class="flex items-center space-x-2 text-gray-500">
                <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>{{ 'gallery.loading'|trans }}</span>
            </div>
        </div>
    {% endif %}
{% endif %}
