{# Category chips carousel — Unsplash-style. Requires: categories, activeCategory, index_route #}
{% if categories is not empty %}
    <div id="category-carousel" class="relative overflow-hidden mb-10" data-carousel>
        <div data-carousel-track
             class="flex gap-2 overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-1 px-0 md:px-12 border border-transparent">
            {% set chipBase = 'shrink-0 w-[145px] truncate px-4 py-3 rounded-lg text-sm font-medium text-center border transition' %}
            {% for category in categories %}
                {% set isActive = activeCategory and activeCategory.id == category.id %}
                {% if isActive %}
                    <span data-active="true"
                          aria-current="page"
                          title="{{ category.name }}"
                          class="{{ chipBase }} bg-white border-black text-black cursor-default">
                    {{ category.name }}
                </span>
                {% else %}
                    <a href="{{ path(index_route, {category: category.slug}) }}"
                       title="{{ category.name }}"
                       class="{{ chipBase }} bg-white border-gray-200 text-gray-700 hover:border-gray-400 hover:text-gray-900">
                        {{ category.name }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>

        {# Left overlay: fade + chevron #}
        <div class="hidden md:flex absolute left-0 top-0 bottom-0 items-center pointer-events-none">
            <div class="h-full w-12 flex items-center justify-start bg-gradient-to-r from-white via-white to-transparent pointer-events-auto">
                <button type="button"
                        data-carousel-prev
                        aria-label="{{ 'gallery.carousel_prev'|trans }}"
                        disabled
                        class="block p-1 text-gray-700 hover:text-gray-900 transition disabled:opacity-0 disabled:pointer-events-none">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                    </svg>
                </button>
            </div>
        </div>

        {# Right overlay: fade + chevron #}
        <div class="hidden md:flex absolute right-0 top-0 bottom-0 items-center pointer-events-none">
            <div class="h-full w-12 flex items-center justify-end bg-gradient-to-l from-white via-white to-transparent pointer-events-auto">
                <button type="button"
                        data-carousel-next
                        aria-label="{{ 'gallery.carousel_next'|trans }}"
                        disabled
                        class="block p-1 text-gray-700 hover:text-gray-900 transition disabled:opacity-0 disabled:pointer-events-none">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
{% endif %}
