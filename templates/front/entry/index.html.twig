{% extends 'front/base_front.html.twig' %}

{% set pageSlug = type.pageSlug ~ '_index' %}

{% block title %}{{ page_meta_title(pageSlug) }}{% endblock %}

{% block meta_description %}{{ page_meta_description(pageSlug) }}{% endblock %}

{% block canonical %}{{ app.request.schemeAndHttpHost ~ path('app_front_entry_index', {type: type.value}) }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('front_entry_index') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('front_entry_index') }}
{% endblock %}

{% block body %}
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center mb-10">
            <h1 class="font-['Bodoni_Moda',serif] font-normal uppercase tracking-wider text-5xl md:text-7xl text-gray-900 mb-4">
                {{ page_title(pageSlug) }}
            </h1>
            {% if page_subtitle(pageSlug) %}
                <p class="text-sm md:text-lg text-gray-600 md:max-w-2xl mx-auto">
                    {{ page_subtitle(pageSlug)|nl2br }}
                </p>
            {% endif %}
        </div>

        {% if entries is empty %}
            <div class="text-center py-20">
                <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                <p class="text-gray-500">{{ 'entry.empty'|trans }}</p>
            </div>
        {% else %}
            <div class="flex flex-col gap-12 max-w-4xl mx-auto">
                {% for entry in entries %}
                    {% set thumbnailUrl = entry.thumbnailUrl %}
                    <article class="flex flex-col">
                        {% if entry.posterPath %}
                            <img src="{{ s3_url(entry.posterPath) }}"
                                 alt="{{ entry.title ? 'Affiche : ' ~ entry.title : 'Affiche' }}"
                                 loading="lazy"
                                 class="w-full max-w-xs mx-auto rounded-lg shadow-sm">
                        {% endif %}

                        {% if entry.title %}
                            <h2 class="{% if entry.posterPath %}mt-4 text-center{% endif %} text-lg font-semibold text-gray-900">
                                {{ entry.title }}
                            </h2>
                        {% endif %}

                        {% if entry.description %}
                            <div class="{% if entry.title %}mt-2{% elseif entry.posterPath %}mt-4{% endif %} text-sm text-gray-600
                                        [&_p]:mb-3 [&_p:last-child]:mb-0
                                        [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-3
                                        [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:mb-3
                                        [&_strong]:font-semibold
                                        [&_em]:italic
                                        [&_u]:underline
                                        [&_a]:underline [&_a]:text-blue-600 [&_a:hover]:text-blue-800 [&_a]:transition
                                        [&_blockquote]:border-l-2 [&_blockquote]:border-gray-300 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:mb-3">
                                {{ entry.description|raw }}
                            </div>
                        {% endif %}

                        {% if entry.provider %}
                            <button type="button"
                                    class="{% if entry.title or entry.description %}mt-6{% endif %} group relative aspect-video bg-gray-900 overflow-hidden rounded-lg shadow-sm cursor-pointer"
                                    data-video-embed
                                    data-embed-url="{{ entry.provider.embedUrl(entry.externalId) }}"
                                    data-video-title="{{ entry.title ?: 'Vidéo' }}"
                                    aria-label="Lire la vidéo{{ entry.title ? ' : ' ~ entry.title : '' }}">
                                {% if thumbnailUrl %}
                                    <img src="{{ thumbnailUrl }}"
                                         alt=""
                                         loading="lazy"
                                         onerror="this.style.display='none'"
                                         class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
                                {% endif %}
                                <div class="absolute inset-0 bg-black/30 group-hover:bg-black/50 transition flex items-center justify-center">
                                    <span class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white/90 group-hover:bg-white shadow-lg transition-transform group-hover:scale-110">
                                        <svg class="w-8 h-8 text-gray-900 ml-1" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </span>
                                </div>
                            </button>
                        {% endif %}

                        {% set pictures = picturesByEntryId[entry.id] ?? [] %}
                        {% if pictures is not empty %}
                            <div class="mt-6 swiper w-full min-w-0 overflow-hidden" data-video-pictures-swiper>
                                <div class="swiper-wrapper">
                                    {% for picture in pictures %}
                                        <div class="swiper-slide">
                                            <img src="{{ s3_url(picture.lightboxPath) }}"
                                                 alt=""
                                                 loading="lazy"
                                                 class="block w-full aspect-video object-cover rounded-lg bg-gray-100">
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="swiper-pagination !relative !mt-4 [&>.swiper-pagination-bullet-active]:!bg-gray-900"></div>
                                <div class="swiper-button-prev !text-gray-800 !bg-white/80 !rounded-full !w-10 !h-10 [&>svg]:!w-3 [&>svg]:!h-3"></div>
                                <div class="swiper-button-next !text-gray-800 !bg-white/80 !rounded-full !w-10 !h-10 [&>svg]:!w-3 [&>svg]:!h-3"></div>
                            </div>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
